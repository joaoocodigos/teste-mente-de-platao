<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Mente de Platão</title>
    <link rel="stylesheet" href="estilos.css"/>
    <script defer src="script.js"></script>
</head>
<body>
    <header>
        <h1>Mente de Platão</h1>
        <nav>
            <ul>
                <li><a href="#vida">Vida</a></li>
                <li><a href="#obras">Obras</a></li>
                <li><a href="#filosofia">Filosofia</a></li>
                <li><a href="#influencia">Legado</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section id="vida">
            <h2>Quem foi Platão?</h2>
            <p>Filósofo ateniense, aluno de Sócrates e mestre de Aristóteles...</p>
        </section>

        <section id="obras">
            <h2>Obras</h2>
            <div class="carrossel">
                <!-- Carrossel JS -->
                <button class="anterior">◀</button>
                <div class="livros">
                    <div class="livro">A República</div>
                    <div class="livro">O Banquete</div>
                    <div class="livro">Fédon</div>
                    <div class="livro">Timeu</div>
                </div>
                <button class="proximo">▶</button>
            </div>
        </section>

        <section id="filosofia">
            <h2>Ideias Filosóficas</h2>
            <p>Teoria das Ideias, Mito da Caverna, dualismo corpo-alma...</p>
        </section>

        <section id="influencia">
            <h2>Legado</h2>
            <p>Influência na filosofia, ciência política, ética e educação...</p>
        </section>
    </main>

    <footer>
        <p>© 2025 - Mente de Platão | Desenvolvido por [Seu Nome]</p>
    </footer>
</body>
</html>
